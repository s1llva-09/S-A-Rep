# Roteamento SPA (React) na hospedagem Apache da Locaweb.
# Faz com que /admin e qualquer rota funcionem ao acessar/recarregar direto.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescrever arquivos ou pastas que realmente existem (js, css, imagens, pdf...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto cai no index.html (o app assume a rota)
  RewriteRule ^ index.html [L]
</IfModule>

# Cache dos assets com hash (seguro, pois o nome muda a cada build)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
</IfModule>

# Não cachear o index.html (pra sempre pegar a versão nova do app)
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
